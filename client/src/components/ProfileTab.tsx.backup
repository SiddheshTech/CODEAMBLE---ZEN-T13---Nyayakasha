import React, { useState } from 'react';
import { motion, AnimatePresence } from 'motion/react';
import { 
  User, ShieldCheck, Mail, Phone, 
  MapPin, Briefcase, Key, 
  CheckCircle2, Lock, Copy, Download,
  Building, FileText, Check, Shield, AlertCircle,
  X, Send, Fingerprint, HardDrive, HelpCircle
} from 'lucide-react';

import { api } from '../services/api';

export function ProfileTab({ role }: { role: string }) {
  const isValidator = role === 'Independent Validator';
  const isCourtAuthority = role === 'Court Authority';

  // State
  const [profileData, setProfileData] = useState<any>(null);
  const [isLoadingProfile, setIsLoadingProfile] = useState(true);
  const [copiedFingerprint, setCopiedFingerprint] = useState(false);
  const [toastMessage, setToastMessage] = useState<string | null>(null);
  
  // Request Change Modal State
  const [showRequestChangeModal, setShowRequestChangeModal] = useState(false);
  const [requestedField, setRequestedField] = useState<'name' | 'bar_council' | 'contact' | 'email'>('name');
  const [requestedNewValue, setRequestedNewValue] = useState('');
  const [requestJustification, setRequestJustification] = useState('');
  const [submittedRequests, setSubmittedRequests] = useState<Array<{
    id: string;
    field: string;
    newValue: string;
    status: 'Pending Admin Review';
    timestamp: string;
  }>>([]);

  React.useEffect(() => {
    setIsLoadingProfile(true);
    api.getProfile()
      .then(data => {
        if (data.success && data.profile) {
          setProfileData(data.profile);
        }
      })
      .catch(err => console.error('Failed to load profile:', err))
      .finally(() => setIsLoadingProfile(false));
  }, []);

  const publicKeyFingerprint = profileData?.keyShareFingerprint || (
    isValidator
      ? '0x9D4F-88E2-11A9-C43B-7720-F01A-99D8-23E1-44B0'
      : isCourtAuthority
      ? '0x8F9A-41B0-C82E-99B1-3310-7F2A-00B2-11D4-884E-90C1-FA32'
      : '0x3E1C-99B4-11A0-7C08-44F2-88B1-002E-77D1-2290-A81B-12D9'
  );

  const showToast = (msg: string) => {
    setToastMessage(msg);
    setTimeout(() => setToastMessage(null), 4000);
  };

  const handleCopyFingerprint = () => {
    navigator.clipboard.writeText(publicKeyFingerprint);
    setCopiedFingerprint(true);
    showToast('Public key fingerprint copied to clipboard');
    setTimeout(() => setCopiedFingerprint(false), 2500);
  };

  const handleDownloadCertificate = () => {
    const certContent = `================================================================
HIGH COURT JUDICIAL EVIDENCE & AUDIT NETWORK
OFFICIAL INSTITUTIONAL VERIFICATION CERTIFICATE
================================================================

CERTIFICATE ID: HC-CERT-2026-8891
ISSUANCE DATE: ${new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
SECURITY TIER: Tier-4 High-Value Evidence Access

SUBJECT DETAILS:
----------------------------------------------------------------
Official Name:    ${profileData.fullName}
Institutional Role: ${role}
Organization:     ${profileData.authorityScope}
Identifier:       ${profileData.appointmentRef}
Bar Membership:   ${profileData.barCouncilNumber}
Official Email:   ${profileData.email}

CRYPTOGRAPHIC ATTESTATION:
----------------------------------------------------------------
Public Key Share: ${publicKeyFingerprint}
MFA Standard:     ${profileData.mfaAttestationLevel}
Ledger Genesis:   ${profileData.keyGenesisDate}
Status:           Verified Active & Authorized

ISSUING AUTHORITY:
High Court Provisioning Admin & Registrar General
Digital Ledger Root Hash: 0x72a910bf8912c00e12f41982b189a

================================================================
`;

    const blob = new Blob([certContent], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `Verification_Certificate_${isValidator ? 'Validator' : 'Court_Authority'}.txt`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);

    showToast('Verification Certificate downloaded successfully');
  };

  const handleSubmitChangeRequest = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!requestedNewValue.trim() || !requestJustification.trim()) return;

    if (requestedField === 'contact') {
      try {
        const data = await api.updateProfile({ contactExtension: requestedNewValue.trim() });
        if (data.success && data.profile) {
           setProfileData(data.profile);
           showToast('Contact updated successfully via API PATCH');
           setShowRequestChangeModal(false);
           setRequestedNewValue('');
           setRequestJustification('');
           return;
        }
      } catch (err) {
        console.error('Update failed', err);
      }
    }

    const fieldNames: Record<string, string> = {
      name: 'Full Official Name',
      bar_council: 'Bar Council / Badge Number',
      contact: 'Office Extension & Location',
      email: 'Official Email Address'
    };

    const newReq = {
      id: `REQ-${Date.now().toString().slice(-4)}`,
      field: fieldNames[requestedField] || requestedField,
      newValue: requestedNewValue.trim(),
      status: 'Pending Admin Review' as const,
      timestamp: 'Just now'
    };

    setSubmittedRequests(prev => [newReq, ...prev]);
    setShowRequestChangeModal(false);
    setRequestedNewValue('');
    setRequestJustification('');
    showToast(`Change request for ${newReq.field} submitted to Provisioning Admin`);
  };

  if (isLoadingProfile) {
    return (
      <div className="space-y-8 max-w-6xl mx-auto font-sans pb-16 relative">
        <div className="h-64 bg-slate-900 rounded-[2rem] border border-white/10 shadow-xl animate-pulse"></div>
        <div className="h-96 bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-xs animate-pulse"></div>
      </div>
    );
  }

  if (!profileData) {
    return (
      <div className="space-y-8 max-w-6xl mx-auto font-sans pb-16 relative flex items-center justify-center min-h-[400px]">
        <div className="p-6 bg-red-50 text-red-900 rounded-2xl border border-red-200">
          Profile data could not be loaded.
        </div>
      </div>
    );
  }

  return (
    <div className="space-y-8 max-w-6xl mx-auto font-sans pb-16 relative">
      
      {/* Toast Notification */}
      <AnimatePresence>
        {toastMessage && (
          <motion.div
            initial={{ opacity: 0, y: -20 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: -20 }}
            className="fixed top-6 right-6 z-50 bg-slate-900 border border-emerald-500/50 text-white px-5 py-3.5 rounded-2xl shadow-2xl flex items-center gap-3 text-xs font-bold"
          >
            <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
            <span>{toastMessage}</span>
          </motion.div>
        )}
      </AnimatePresence>

      {/* Profile Header Banner */}
      <div className="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white p-6 sm:p-8 rounded-[2rem] border border-white/10 shadow-xl relative overflow-hidden">
        <div className="absolute top-0 right-0 w-80 h-80 bg-indigo-500/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4"></div>
        
        <div className="relative z-10 flex flex-col lg:flex-row gap-6 lg:items-center justify-between">
          <div className="flex flex-col sm:flex-row items-start sm:items-center gap-6">
            <div className="relative shrink-0">
              <div className="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl bg-gradient-to-br from-amber-400 to-amber-600 text-slate-950 font-black text-2xl sm:text-3xl flex items-center justify-center shadow-lg border-4 border-white/20">
                {profileData.fullName.split(' ').map((n: string) => n[0]).join('').substring(0,2).toUpperCase()}
              </div>
              <div className="absolute -bottom-2 -right-2 w-8 h-8 bg-emerald-500 rounded-full border-4 border-slate-900 flex items-center justify-center shadow-sm" title="Institutional Identity Verified">
                <ShieldCheck className="w-4 h-4 text-white" />
              </div>
            </div>

            <div className="space-y-1.5">
              <div className="flex flex-wrap items-center gap-3">
                <h1 className="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
                  {profileData.fullName}
                </h1>
                <span className="px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 text-xs font-extrabold uppercase tracking-wider flex items-center gap-1.5">
                  <ShieldCheck className="w-3.5 h-3.5 text-emerald-400" /> Institutionally Verified
                </span>
              </div>
              <p className="text-sm sm:text-base text-slate-300 font-medium">
                {isValidator ? 'Independent Oversight Master & Validator • Judicial Oversight Board' : isCourtAuthority ? 'Presiding Judge • High Court Division Bench' : 'Senior Investigating Officer • Cyber Crime Cell'}
              </p>
              <div className="flex flex-wrap items-center gap-4 text-xs text-slate-400 pt-1">
                <div className="flex items-center gap-1.5 font-medium">
                  <Briefcase className="w-3.5 h-3.5 text-amber-400" /> ID: {profileData.appointmentRef}
                </div>
                <div className="flex items-center gap-1.5 font-medium">
                  <Building className="w-3.5 h-3.5 text-indigo-400" /> {profileData.authorityScope}
                </div>
              </div>
            </div>
          </div>

          {/* Download Certificate Action */}
          <div className="flex flex-col sm:items-end gap-3 border-t lg:border-t-0 border-white/10 pt-4 lg:pt-0 shrink-0">
            <button
              onClick={handleDownloadCertificate}
              className="px-5 py-3 rounded-2xl bg-amber-400 hover:bg-amber-300 text-slate-950 text-xs font-extrabold flex items-center gap-2.5 shadow-lg transition-all cursor-pointer"
            >
              <Download className="w-4 h-4 text-slate-950" />
              <span>Download Verification Certificate</span>
            </button>
            <span className="text-[11px] font-mono text-slate-400 flex items-center gap-1">
              <Lock className="w-3 h-3 text-emerald-400" /> High Court Signed Certificate
            </span>
          </div>
        </div>
      </div>

      {/* Pending Change Requests Banner if any exist */}
      {submittedRequests.length > 0 && (
        <div className="p-4 rounded-2xl bg-amber-50 border border-amber-300 text-amber-950 text-xs space-y-2">
          <div className="flex items-center gap-2 font-extrabold text-amber-900">
            <AlertCircle className="w-4 h-4 text-amber-700" />
            <span>Pending Institutional Change Requests ({submittedRequests.length})</span>
          </div>
          <div className="space-y-1">
            {submittedRequests.map(req => (
              <div key={req.id} className="flex items-center justify-between text-xs bg-white/80 p-2.5 rounded-xl border border-amber-200">
                <span className="font-semibold text-slate-800">Request for <strong>{req.field}</strong> → "{req.newValue}"</span>
                <span className="px-2.5 py-0.5 rounded-full bg-amber-200 text-amber-900 font-mono text-[10px] font-bold">
                  {req.status}
                </span>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* SINGLE PAGE ORGANIZED INTO THREE VISUAL SECTIONS */}

      {/* SECTION 1: PERSONAL INFO */}
      <section className="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-xs space-y-6">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-100">
          <div className="space-y-1">
            <div className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 text-[11px] font-extrabold uppercase tracking-wider">
              <User className="w-3.5 h-3.5 text-indigo-600" /> Visual Section 1 of 3
            </div>
            <h2 className="text-xl font-extrabold text-slate-900 flex items-center gap-2">
              Personal Info &amp; Official Identity
            </h2>
            <p className="text-xs text-slate-500 font-medium">
              Profile details are institutionally verified at signup. Direct editing is disabled to preserve judicial chain-of-custody.
            </p>
          </div>

          <button
            onClick={() => setShowRequestChangeModal(true)}
            className="px-4 py-2.5 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-extrabold flex items-center gap-2 shadow-xs transition-all shrink-0 cursor-pointer"
          >
            <Send className="w-3.5 h-3.5" />
            <span>Request change</span>
          </button>
        </div>

        {/* Institutional Verification Lock Note */}
        <div className="p-3.5 rounded-2xl bg-slate-900 border border-slate-800 flex items-start sm:items-center justify-between gap-3 text-xs text-slate-200">
          <div className="flex items-center gap-2.5 font-medium">
            <Lock className="w-4 h-4 text-emerald-400 shrink-0" />
            <span><strong>Institutional Lock Active:</strong> Name, Bar Council credentials, and contact details were verified at account creation. Any modifications route to the Provisioning Admin for approval.</span>
          </div>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div className="space-y-1.5">
            <label className="text-xs font-bold text-slate-700 flex items-center justify-between">
              <span>Full Official Name</span>
              <span className="text-[10px] text-slate-400 font-normal">Verified at signup</span>
            </label>
            <div className="relative">
              <input 
                type="text" 
                value={profileData.fullName} 
                disabled
                className="w-full px-4 py-3 bg-slate-100 border border-slate-200 rounded-2xl text-slate-900 text-xs font-bold cursor-not-allowed"
              />
              <Lock className="w-3.5 h-3.5 absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400" />
            </div>
          </div>

          <div className="space-y-1.5">
            <label className="text-xs font-bold text-slate-700 flex items-center justify-between">
              <span>Official Email Address</span>
              <span className="text-[10px] text-slate-400 font-normal">High Court Domain</span>
            </label>
            <div className="relative">
              <input 
                type="text" 
                value={profileData.email} 
                disabled
                className="w-full px-4 py-3 bg-slate-100 border border-slate-200 rounded-2xl text-slate-900 text-xs font-bold cursor-not-allowed"
              />
              <Lock className="w-3.5 h-3.5 absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400" />
            </div>
          </div>

          <div className="space-y-1.5">
            <label className="text-xs font-bold text-slate-700 flex items-center justify-between">
              <span>Contact Extension &amp; Phone</span>
              <span className="text-[10px] text-slate-400 font-normal font-mono">Secure Extension</span>
            </label>
            <div className="relative">
              <input 
                type="text" 
                value={profileData.contactExtension} 
                disabled
                className="w-full px-4 py-3 bg-slate-100 border border-slate-200 rounded-2xl text-slate-900 text-xs font-bold cursor-not-allowed"
              />
              <Lock className="w-3.5 h-3.5 absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400" />
            </div>
          </div>

          <div className="space-y-1.5">
            <label className="text-xs font-bold text-slate-700 flex items-center justify-between">
              <span>Chambers / Office Location</span>
              <span className="text-[10px] text-slate-400 font-normal">Judicial Premises</span>
            </label>
            <div className="relative">
              <input 
                type="text" 
                value={profileData.chambersLocation} 
                disabled
                className="w-full px-4 py-3 bg-slate-100 border border-slate-200 rounded-2xl text-slate-900 text-xs font-bold cursor-not-allowed"
              />
              <Lock className="w-3.5 h-3.5 absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400" />
            </div>
          </div>
        </div>
      </section>

      {/* SECTION 2: CREDENTIALS */}
      <section className="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-xs space-y-6">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-100">
          <div className="space-y-1">
            <div className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[11px] font-extrabold uppercase tracking-wider">
              <Briefcase className="w-3.5 h-3.5 text-emerald-600" /> Visual Section 2 of 3
            </div>
            <h2 className="text-xl font-extrabold text-slate-900 flex items-center gap-2">
              Credentials &amp; Institutional Accreditation
            </h2>
            <p className="text-xs text-slate-500 font-medium">
              Bar council accreditation, judicial appointment numbers, and signed verification documents for institutional recordkeeping.
            </p>
          </div>

          <button
            onClick={handleDownloadCertificate}
            className="px-4 py-2.5 rounded-2xl bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-extrabold flex items-center gap-2 shadow-xs transition-all shrink-0 cursor-pointer"
          >
            <Download className="w-3.5 h-3.5" />
            <span>Download verification certificate</span>
          </button>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div className="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-1">
            <span className="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Bar Council / Badge No.</span>
            <span className="font-mono text-sm font-extrabold text-slate-900 block">
              {profileData.barCouncilNumber}
            </span>
            <span className="text-[11px] text-emerald-700 font-semibold flex items-center gap-1 pt-1">
              <CheckCircle2 className="w-3 h-3 text-emerald-600" /> High Court Registered
            </span>
          </div>

          <div className="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-1">
            <span className="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Appointment Ref &amp; Seal</span>
            <span className="font-mono text-sm font-extrabold text-slate-900 block">
              {profileData.appointmentRef}
            </span>
            <span className="text-[11px] text-slate-500 font-medium pt-1 block">
              Attested by High Court Registrar
            </span>
          </div>

          <div className="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-1">
            <span className="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Authority &amp; Quorum Scope</span>
            <span className="font-extrabold text-slate-900 text-xs block">
              {profileData.authorityScope}
            </span>
            <span className="text-[11px] text-indigo-700 font-semibold flex items-center gap-1 pt-1">
              <ShieldCheck className="w-3 h-3 text-indigo-600" /> Full Signature Rights
            </span>
          </div>
        </div>

        {/* Certificate Card Preview */}
        <div className="p-5 rounded-2xl bg-slate-900 text-white flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div className="space-y-1">
            <div className="flex items-center gap-2">
              <FileText className="w-4 h-4 text-amber-400" />
              <span className="text-xs font-extrabold uppercase tracking-wider text-amber-300">Signed Role Confirmation Certificate</span>
            </div>
            <p className="text-xs text-slate-300">
              Generates a cryptographically signed TXT/PDF certificate confirming verified institutional status, suitable for audit documentation and registry filings.
            </p>
          </div>
          <button
            onClick={handleDownloadCertificate}
            className="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-amber-300 border border-amber-400/30 text-xs font-bold transition-all shrink-0 cursor-pointer flex items-center gap-2"
          >
            <Download className="w-3.5 h-3.5" />
            <span>Download certificate</span>
          </button>
        </div>
      </section>

      {/* SECTION 3: SECURITY KEYS */}
      <section className="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-xs space-y-6">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-100">
          <div className="space-y-1">
            <div className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 text-amber-800 text-[11px] font-extrabold uppercase tracking-wider">
              <Key className="w-3.5 h-3.5 text-amber-600" /> Visual Section 3 of 3
            </div>
            <h2 className="text-xl font-extrabold text-slate-900 flex items-center gap-2">
              Security Keys &amp; Cryptographic Enclave
            </h2>
            <p className="text-xs text-slate-500 font-medium">
              Public key fingerprint for decryption key shares, WebAuthn hardware token attestations, and security factors.
            </p>
          </div>

          <button
            onClick={handleCopyFingerprint}
            className="px-4 py-2.5 rounded-2xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-extrabold flex items-center gap-2 shadow-xs transition-all shrink-0 cursor-pointer"
          >
            {copiedFingerprint ? <Check className="w-3.5 h-3.5 text-emerald-400" /> : <Copy className="w-3.5 h-3.5" />}
            <span>{copiedFingerprint ? 'Fingerprint copied!' : 'Copy fingerprint'}</span>
          </button>
        </div>

        {/* Public Key Fingerprint Box */}
        <div className="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
          <div className="flex items-center justify-between">
            <span className="text-xs font-bold text-slate-600 uppercase tracking-wider flex items-center gap-1.5">
              <Fingerprint className="w-4 h-4 text-indigo-600" />
              Public Key Fingerprint (Decryption-Key Share)
            </span>
            <button
              onClick={handleCopyFingerprint}
              className="px-3 py-1.5 rounded-xl bg-white border border-slate-200 text-slate-800 text-xs font-bold hover:bg-slate-100 transition-all flex items-center gap-1.5 shadow-2xs cursor-pointer"
            >
              {copiedFingerprint ? (
                <>
                  <Check className="w-3.5 h-3.5 text-emerald-600" />
                  <span className="text-emerald-700 font-bold">Copied!</span>
                </>
              ) : (
                <>
                  <Copy className="w-3.5 h-3.5 text-slate-500" />
                  <span>Copy fingerprint</span>
                </>
              )}
            </button>
          </div>

          <div className="p-4 bg-slate-900 text-amber-300 font-mono text-sm sm:text-base font-bold rounded-2xl tracking-wider border border-slate-800 select-all break-all text-center shadow-inner">
            {publicKeyFingerprint}
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-xs">
            <div className="p-3 bg-white rounded-xl border border-slate-200 space-y-0.5">
              <span className="text-slate-400 block font-semibold text-[10px] uppercase">Cryptographic Algorithm</span>
              <span className="font-extrabold text-slate-800 block">
                {isValidator ? 'CKKS-Paillier-2048 Threshold Share' : 'Ed25519-EdDSA Enclave'}
              </span>
            </div>
            <div className="p-3 bg-white rounded-xl border border-slate-200 space-y-0.5">
              <span className="text-slate-400 block font-semibold text-[10px] uppercase">Key Genesis Date</span>
              <span className="font-extrabold text-slate-800 block">{profileData.keyGenesisDate}</span>
            </div>
            <div className="p-3 bg-white rounded-xl border border-slate-200 space-y-0.5">
              <span className="text-slate-400 block font-semibold text-[10px] uppercase">Hardware Status</span>
              <span className="font-extrabold text-emerald-700 flex items-center gap-1">
                <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600" /> Active Hardware Token
              </span>
            </div>
          </div>
        </div>

        {/* Registered MFA Factor Detail */}
        <div className="space-y-3 pt-2">
          <span className="text-xs font-bold text-slate-500 uppercase tracking-wider block">
            REGISTERED HARDWARE SECURITY FACTOR
          </span>
          <div className="p-4 rounded-2xl border border-slate-200 bg-slate-50 flex items-center justify-between gap-4">
            <div className="flex items-center gap-3">
              <div className="w-10 h-10 rounded-xl bg-amber-100 text-amber-800 border border-amber-200 flex items-center justify-center shrink-0">
                <Key className="w-5 h-5" />
              </div>
              <div>
                <h4 className="text-xs font-bold text-slate-900">{profileData.hardwareTokenName}</h4>
                <p className="text-[11px] text-slate-500 font-medium">{profileData.mfaAttestationLevel}</p>
              </div>
            </div>
            <span className="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-extrabold border border-emerald-300">
              Verified Primary
            </span>
          </div>
        </div>
      </section>

      {/* EXPLICITLY ABSENT: NO DELETE ACCOUNT BUTTON — ADMIN-ONLY LIFECYCLE NOTICE */}
      <div className="p-5 rounded-2xl bg-slate-100 border border-slate-200 text-slate-600 text-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div className="flex items-start gap-3">
          <Shield className="w-5 h-5 text-slate-500 shrink-0 mt-0.5" />
          <div className="space-y-0.5">
            <span className="font-extrabold text-slate-800 block">Institutional Account Lifecycle Policy</span>
            <p className="text-slate-500 leading-relaxed">
              Self-service account deletion is explicitly disabled across the platform. Institutional accounts are legally provisioned and can only be modified, suspended, or deactivated by the High Court Provisioning Admin.
            </p>
          </div>
        </div>
        <span className="px-3 py-1.5 rounded-xl bg-slate-200 text-slate-700 font-mono text-[11px] font-bold shrink-0">
          Deactivation: Admin Only
        </span>
      </div>

      {/* REQUEST CHANGE MODAL */}
      <AnimatePresence>
        {showRequestChangeModal && (
          <div className="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4">
            <motion.div
              initial={{ opacity: 0, scale: 0.95 }}
              animate={{ opacity: 1, scale: 1 }}
              exit={{ opacity: 0, scale: 0.95 }}
              className="bg-white rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl border border-slate-200 space-y-6"
            >
              <div className="flex items-center justify-between pb-3 border-b border-slate-100">
                <div className="space-y-0.5">
                  <h3 className="text-base font-extrabold text-slate-900 flex items-center gap-2">
                    <Send className="w-4 h-4 text-indigo-600" /> Request Official Profile Field Change
                  </h3>
                  <p className="text-xs text-slate-500">
                    Changes to institutionally verified fields require Provisioning Admin approval.
                  </p>
                </div>
                <button
                  onClick={() => setShowRequestChangeModal(false)}
                  className="p-1 rounded-lg text-slate-400 hover:text-slate-700 cursor-pointer"
                >
                  <X className="w-5 h-5" />
                </button>
              </div>

              <form onSubmit={handleSubmitChangeRequest} className="space-y-4">
                <div className="space-y-1.5">
                  <label className="text-xs font-bold text-slate-700">Target Field to Update</label>
                  <select
                    value={requestedField}
                    onChange={(e) => setRequestedField(e.target.value as any)}
                    className="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-900 outline-none focus:border-indigo-500"
                  >
                    <option value="name">Full Official Name</option>
                    <option value="bar_council">Bar Council Number / Police Badge ID</option>
                    <option value="contact">Contact Number / Landline Extension</option>
                    <option value="email">Official Email Address</option>
                  </select>
                </div>

                <div className="space-y-1.5">
                  <label className="text-xs font-bold text-slate-700">New Requested Value</label>
                  <input
                    type="text"
                    required
                    placeholder="Enter requested updated value..."
                    value={requestedNewValue}
                    onChange={(e) => setRequestedNewValue(e.target.value)}
                    className="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-900 outline-none focus:border-indigo-500 placeholder-slate-400"
                  />
                </div>

                <div className="space-y-1.5">
                  <label className="text-xs font-bold text-slate-700">Institutional Rationale / Justification</label>
                  <textarea
                    required
                    rows={3}
                    placeholder="Provide official reason or Gazette reference for this change..."
                    value={requestJustification}
                    onChange={(e) => setRequestJustification(e.target.value)}
                    className="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-900 outline-none focus:border-indigo-500 placeholder-slate-400 resize-none"
                  />
                </div>

                <div className="p-3.5 rounded-xl bg-indigo-50 border border-indigo-200 text-xs text-indigo-950 space-y-1">
                  <span className="font-extrabold block">Admin Routing Notice</span>
                  <p className="text-indigo-800 text-[11px] leading-relaxed">
                    Upon submission, your change request will be routed directly to the High Court Registrar / Provisioning Admin console for identity verification.
                  </p>
                </div>

                <div className="flex items-center justify-end gap-3 pt-2">
                  <button
                    type="button"
                    onClick={() => setShowRequestChangeModal(false)}
                    className="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold cursor-pointer"
                  >
                    Cancel
                  </button>
                  <button
                    type="submit"
                    className="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-extrabold transition-all shadow-xs flex items-center gap-2 cursor-pointer"
                  >
                    <Send className="w-3.5 h-3.5" />
                    <span>Submit Request to Admin</span>
                  </button>
                </div>
              </form>
            </motion.div>
          </div>
        )}
      </AnimatePresence>

    </div>
  );
}

